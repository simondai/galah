<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Uber-language dark palette (DESIGN-uber.md): pure-black canvas, grayscale hierarchy,
         polarity-flipped primary (white pill on dark), no chromatic accent. -->
    <SolidColorBrush x:Key="Galah.Panel.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="Galah.Panel.Border" Color="#FF333333" />
    <SolidColorBrush x:Key="Galah.Chrome.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="Galah.TabStrip.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="Galah.Text.Primary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Text.Secondary" Color="#FFAFAFAF" />
    <SolidColorBrush x:Key="Galah.Accent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Tile.Background" Color="#00000000" />
    <SolidColorBrush x:Key="Galah.Tile.Hover" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="Galah.Tile.Selected" Color="#FF282828" />
    <SolidColorBrush x:Key="Galah.Button.Background" Color="#FF282828" />
    <SolidColorBrush x:Key="Galah.Button.Border" Color="#FF333333" />
    <SolidColorBrush x:Key="Galah.Button.Foreground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Input.Background" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="Galah.Input.Border" Color="#FF333333" />
    <SolidColorBrush x:Key="Galah.Toast.Background" Color="#E6282828" />
    <SolidColorBrush x:Key="Galah.Toast.Foreground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Banner.Background" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Galah.Banner.Border" Color="#FFAFAFAF" />
    <SolidColorBrush x:Key="Galah.Badge.Foreground" Color="#FF000000" />
    <SolidColorBrush x:Key="Galah.Badge.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Separator" Color="#FF262626" />

    <!-- DESIGN-uber.md tokens (dark inversion) -->
    <SolidColorBrush x:Key="Galah.ActionBlue" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.OnPrimary" Color="#FF000000" />
    <SolidColorBrush x:Key="Galah.Parchment" Color="#FF000000" />
    <SolidColorBrush x:Key="Galah.Pearl" Color="#FF282828" />
    <SolidColorBrush x:Key="Galah.InkMuted80" Color="#FFEFEFEF" />
    <SolidColorBrush x:Key="Galah.InkMuted48" Color="#FFAFAFAF" />
    <SolidColorBrush x:Key="Galah.Hairline" Color="#FF333333" />
    <SolidColorBrush x:Key="Galah.DividerSoft" Color="#FF262626" />

    <SolidColorBrush x:Key="Galah.Panel.Translucent" Color="#E8000000" />

</ResourceDictionary>
