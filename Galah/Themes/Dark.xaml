<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Uber-language dark palette (DESIGN-uber.md, softened): charcoal canvas instead of pure
         black, grayscale hierarchy, polarity-flipped primary (white pill on dark), no chromatic accent. -->
    <SolidColorBrush x:Key="Galah.Panel.Background" Color="#FF232327" />
    <SolidColorBrush x:Key="Galah.Panel.Border" Color="#FF3C3C41" />
    <SolidColorBrush x:Key="Galah.Chrome.Background" Color="#FF2A2A2E" />
    <SolidColorBrush x:Key="Galah.TabStrip.Background" Color="#FF232327" />
    <SolidColorBrush x:Key="Galah.Text.Primary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Text.Secondary" Color="#FFB0B0B4" />
    <SolidColorBrush x:Key="Galah.Accent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Tile.Background" Color="#00000000" />
    <SolidColorBrush x:Key="Galah.Tile.Hover" Color="#FF323236" />
    <SolidColorBrush x:Key="Galah.Tile.Selected" Color="#FF3A3A3F" />
    <SolidColorBrush x:Key="Galah.Button.Background" Color="#FF3A3A3F" />
    <SolidColorBrush x:Key="Galah.Button.Border" Color="#FF46464B" />
    <SolidColorBrush x:Key="Galah.Button.Foreground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Input.Background" Color="#FF2E2E32" />
    <SolidColorBrush x:Key="Galah.Input.Border" Color="#FF46464B" />
    <SolidColorBrush x:Key="Galah.Toast.Background" Color="#E6303034" />
    <SolidColorBrush x:Key="Galah.Toast.Foreground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Banner.Background" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Galah.Banner.Border" Color="#FFB0B0B4" />
    <SolidColorBrush x:Key="Galah.Badge.Foreground" Color="#FF000000" />
    <SolidColorBrush x:Key="Galah.Badge.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.Separator" Color="#FF343438" />

    <!-- DESIGN-uber.md tokens (dark inversion) -->
    <SolidColorBrush x:Key="Galah.ActionBlue" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Galah.OnPrimary" Color="#FF000000" />
    <SolidColorBrush x:Key="Galah.Parchment" Color="#FF232327" />
    <SolidColorBrush x:Key="Galah.Pearl" Color="#FF3A3A3F" />
    <SolidColorBrush x:Key="Galah.InkMuted80" Color="#FFEFEFEF" />
    <SolidColorBrush x:Key="Galah.InkMuted48" Color="#FF8E8E93" />
    <SolidColorBrush x:Key="Galah.Hairline" Color="#FF46464B" />
    <SolidColorBrush x:Key="Galah.DividerSoft" Color="#FF343438" />

    <SolidColorBrush x:Key="Galah.Panel.Translucent" Color="#E8232327" />

    <!-- popup surfaces (menus) -->
    <SolidColorBrush x:Key="Galah.Popup.Background" Color="#FF2E2E32" />

</ResourceDictionary>
