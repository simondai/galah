<Application x:Class="Galah.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- The active theme dictionary is inserted at boot by ThemeService (light/dark). -->

        <!-- Global button language, one style family for every window. Kept inline (no Source)
             so ThemeService's dictionary swap never removes them.
             Implicit = utility button (pearl + soft ring, 8px); Galah.ButtonPrimary = the action. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Galah.Button.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Galah.DividerSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform>
                                <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Galah.ButtonPrimary" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Galah.ActionBlue}" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.OnPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.RenderTransform>
                                <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="0.95" ScaleY="0.95" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Menu language: WPF's default ContextMenu/MenuItem templates read SystemColors, so
             popups stay light even in dark mode. These implicit styles re-skin every menu through
             the theme dictionaries (DynamicResource, so a ThemeService swap re-colors live).
             Kept inline (no Source) so the swap never removes them. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Galah.Popup.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Galah.Panel.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="6" Margin="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
                            </Border.Effect>
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- MenuItem templates. WPF's default menu templates read SystemColors (popups stay
             light in dark mode), so everything is re-skinned through the theme dictionaries.
             Role decides the template: headers (☰ top-level, "移到其他分类…" nested) need a
             template that owns the submenu Popup (PART_Popup) or the submenu never opens;
             leaves get the simple hover template. -->
        <ControlTemplate x:Key="Galah.MenuItemLeaf" TargetType="MenuItem">
            <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="10,6">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                  TextBlock.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Secondary}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="Galah.MenuItemHeaderBottom" TargetType="MenuItem">
            <Grid>
                <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{DynamicResource Galah.Popup.Background}"
                            BorderBrush="{DynamicResource Galah.Panel.Border}" BorderThickness="1"
                            CornerRadius="10" Padding="6" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="Galah.MenuItemHeaderRight" TargetType="MenuItem">
            <Grid>
                <Border x:Name="bg" Background="Transparent" CornerRadius="6" Padding="10,6">
                    <Grid>
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        <TextBlock Text="▸" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" FontSize="10" />
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{DynamicResource Galah.Popup.Background}"
                            BorderBrush="{DynamicResource Galah.Panel.Border}" BorderThickness="1"
                            CornerRadius="10" Padding="6" Margin="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Secondary}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
            <Setter Property="Template" Value="{StaticResource Galah.MenuItemLeaf}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource Galah.MenuItemHeaderBottom}" />
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource Galah.MenuItemHeaderRight}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Separator}">
            <!-- Kill every inherited margin/padding from theme-level styles (they made the line
                 asymmetric inside the popup), then draw a hairline that stretches edge to edge
                 with symmetric breathing room matching the leaf items' horizontal padding. -->
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource Galah.Separator}"
                                Margin="10,4" HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
