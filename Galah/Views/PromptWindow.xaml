<Window x:Class="Galah.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Width="400" SizeToContent="Height" MinHeight="120"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, system-ui, sans-serif" FontSize="12.5"
        Icon="{DynamicResource Galah.WindowIcon}" Background="{DynamicResource Galah.Panel.Background}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <StackPanel Margin="16,14,16,14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource Galah.Text.Primary}" />
        <TextBox x:Name="InputBox" Margin="0,12,0,0" Padding="4,3" Visibility="Collapsed"
                 Background="{DynamicResource Galah.Input.Background}"
                 Foreground="{DynamicResource Galah.Text.Primary}"
                 BorderBrush="{DynamicResource Galah.Input.Border}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <!-- 中文界面习惯：动作按钮在左，取消在右（用户规范 2026-11-18） -->
                        <Button x:Name="OkButton" Content="确定" MinWidth="84" Padding="18,10" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click" Style="{StaticResource Galah.ButtonPrimary}" />
                        <Button Content="取消" MinWidth="74" Padding="14,8" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
