<Window x:Class="Galah.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Galah.ViewModels"
        xmlns:views="clr-namespace:Galah.Views"
        Title="Galah"
        Width="720" Height="460" MinWidth="460" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, system-ui, sans-serif"
        Background="Transparent"
        AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver" DragEnter="Root_DragEnter"
        Deactivated="Window_Deactivated" KeyDown="Window_KeyDown"
        PreviewMouseMove="Window_PreviewMouseMove" PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Galah.Tile.Selected}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Galah.Tile.Background}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Galah.Tile.Selected}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Galah.ActionBlue}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="18" BorderThickness="1"
            BorderBrush="{DynamicResource Galah.Panel.Border}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Galah.Panel.Background}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTranslucentMaterial}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Galah.Panel.Translucent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ custom chrome ============ -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0" Background="{DynamicResource Galah.Chrome.Background}"
                    Height="34" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Galah.Text.Primary}" />
                        <TextBlock Text="· 启动器" FontSize="11" Margin="6,1,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Galah.Text.Secondary}" />
                    </StackPanel>
                    <Menu Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <MenuItem Header="☰" Foreground="{DynamicResource Galah.Text.Primary}">
                            <MenuItem Header="添加快捷方式…" Command="{Binding AddPickerCommand}" />
                            <MenuItem Header="维护与迁移…" Click="Maintenance_Click" />
                            <MenuItem Header="设置…" Command="{Binding ShowSettingsCommand}" />
                            <Separator />
                            <MenuItem Header="新建分类" Command="{Binding NewTabCommand}" />
                            <MenuItem Header="收起面板" Command="{Binding HideCommand}" />
                            <Separator />
                            <MenuItem Header="退出程序" Command="{Binding ExitCommand}" />
                        </MenuItem>
                    </Menu>
                    <Button Grid.Column="2" x:Name="CloseButton" Style="{StaticResource ChromeButton}" Content="✕"
                            Margin="4,0,0,0" Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="隐藏面板（程序继续驻留后台）" />
                </Grid>
            </Border>

            <!-- ============ save-failure banner (INV-9) ============ -->
            <Border Grid.Row="1" Visibility="{Binding HasSaveProblem, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource Galah.Banner.Background}"
                    BorderBrush="{DynamicResource Galah.Banner.Border}" BorderThickness="0,0,0,1" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="未能保存，改动仍保留在内存中：" Foreground="{DynamicResource Galah.Text.Primary}" FontSize="12" />
                    <TextBlock Text="{Binding SaveProblem}" Foreground="{DynamicResource Galah.Text.Primary}" FontSize="12"
                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    <Button Content="点击重试" Margin="10,0,0,0" Padding="8,2" FontSize="12"
                            Command="{Binding RetrySaveCommand}"
                            Background="{DynamicResource Galah.Button.Background}"
                            BorderBrush="{DynamicResource Galah.Button.Border}"
                            Foreground="{DynamicResource Galah.Button.Foreground}" />
                </StackPanel>
            </Border>

            <!-- ============ content: tab strip + icon grid (top or left placement) ============ -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

            <!-- ============ tab strip ============ -->
            <Border x:Name="TabStripArea"
                    Background="{DynamicResource Galah.TabStrip.Background}" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource Galah.DividerSoft}">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- defaults live in setters so the vertical trigger can override them
                             (style setters cannot beat local attribute values in WPF) -->
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabVertical}" Value="True">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                <Setter Property="Width" Value="150" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <!-- chip follows the last category in BOTH layouts: a round translucent
                             button in the same stack, so the strip reads as one continuous list -->
                        <StackPanel x:Name="TabRail">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Orientation" Value="Horizontal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabVertical}" Value="True">
                                            <Setter Property="Orientation" Value="Vertical" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsTabVertical, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" />
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TabButton}" MouseLeftButtonUp="Tab_Click"
                                            AllowDrop="True" DragOver="Tab_DragOver" Drop="Tab_Drop"
                                            Tag="{Binding}">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="重命名…" Click="TabRename_Click" />
                                <Separator />
                                                <MenuItem Header="前移" Click="TabMoveLeft_Click" />
                                                <MenuItem Header="后移" Click="TabMoveRight_Click" />
                                                <Separator />
                                                <MenuItem Header="删除分类…" Click="TabDelete_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- left accent bar: vertical placement -->
                                            <Rectangle Grid.Row="0" Grid.Column="0" Width="3" Margin="0,4,4,4"
                                                   RadiusX="1" RadiusY="1" VerticalAlignment="Stretch"
                                                   Fill="{DynamicResource Galah.Accent}">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                    <Condition Binding="{Binding DataContext.IsTabVertical, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>

                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                       Foreground="{DynamicResource Galah.Text.Primary}" MaxWidth="118"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsTabVertical, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- underline bar: top placement -->
                                            <Rectangle Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="2"
                                                   Margin="0,4,0,0" RadiusX="1" RadiusY="1"
                                                   Fill="{DynamicResource Galah.Accent}">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                    <Condition Binding="{Binding DataContext.IsTabVertical, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                </DataTemplate>

                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- new-category chip: DESIGN.md button-icon-circular grammar -->
                        <Button Command="{Binding NewTabCommand}" ToolTip="新建分类"
                                Width="28" Height="28" MinWidth="0" Padding="0"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource Galah.Text.Secondary}"
                                AutomationProperties.Name="新建分类">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Margin" Value="4,1,4,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabVertical}" Value="True">
                                            <Setter Property="Margin" Value="11,6,0,4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="chip" Background="#26D2D2D7" CornerRadius="14"
                                            Width="28" Height="28">
                                        <TextBlock Text="＋" FontSize="15" FontWeight="Light"
                                                   Foreground="{DynamicResource Galah.Text.Primary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="chip" Property="Background" Value="#40D2D2D7" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="chip" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="chip" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============ icon grid ============ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabVertical}" Value="True">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ScrollViewer x:Name="TileScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="8,8,8,34"
                              PreviewMouseWheel="TileScroll_PreviewMouseWheel">
                    <ScrollViewer.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="添加快捷方式…" Click="AddPicker_Click" />
                            <Separator />
                            <MenuItem Header="从路径添加应用…" Click="AddApp_Click" />
                            <MenuItem Header="添加文件或文件夹…" Click="AddFileFolder_Click" />
                            <MenuItem Header="添加链接…" Click="AddUrl_Click" />
                            <Separator />
                            <MenuItem Header="新建分类…" Click="NewTab_Click" />
                        </ContextMenu>
                    </ScrollViewer.ContextMenu>
                    <Grid x:Name="GridRoot" AllowDrop="True" DragOver="Grid_DragOver" DragLeave="Grid_DragLeave" Drop="Grid_Drop">
                        <ItemsControl x:Name="TileItems" ItemsSource="{Binding Items}" Background="Transparent">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TileBorder}" MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                                            PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                            Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            Tag="{Binding}">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="打开" Click="TileOpen_Click" />
                                                <MenuItem Header="编辑…" Click="TileEdit_Click" />
                                                <Separator />
                                                <MenuItem Header="左移" Click="TileMoveLeft_Click" />
                                                <MenuItem Header="右移" Click="TileMoveRight_Click" />
                                                <MenuItem x:Name="MoveToTabMenu" Header="移到其他分类…"
                                                         SubmenuOpened="MoveToTabMenu_SubmenuOpened" />
                                                <Separator />
                                                <MenuItem Header="从库中删除" Click="TileDelete_Click" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid HorizontalAlignment="Center"
                                                  Width="{Binding IconEdge}" Height="{Binding IconEdge}">
                                                <Image Source="{Binding Icon}" Width="{Binding IconEdge}"
                                                       Height="{Binding IconEdge}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border Width="16" Height="16" CornerRadius="8"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-3,-3,0" Background="{DynamicResource Galah.Badge.Background}"
                                                        Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="目标当前不可用（此标记不会写入数据）">
                                                    <TextBlock Text="!" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource Galah.Badge.Foreground}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="0,5,0,0"
                                                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Galah.Text.Primary}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- insertion indicator shown while a tile is dragged over the grid -->
                        <Rectangle x:Name="DropIndicator" Width="2" RadiusX="1" RadiusY="1"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Visibility="Collapsed" IsHitTestVisible="False"
                                   Fill="{DynamicResource Galah.Accent}" />

                        <TextBlock Text="从资源管理器把程序 / 文件夹 / 链接拖到这里，或使用右键菜单添加"
                                   FontSize="12" Foreground="{DynamicResource Galah.Text.Secondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>

                <!-- toast strip -->
                <Border Visibility="{Binding Toast.IsOpen, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Galah.Toast.Background}" CornerRadius="6"
                        Padding="12,7" Margin="16,0,16,12" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        IsHitTestVisible="False" MaxWidth="520">
                    <TextBlock Text="{Binding Toast.Message}" Foreground="{DynamicResource Galah.Toast.Foreground}"
                               FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </Grid>
            </Grid>   <!-- content grid (tab strip + tiles) -->
        </Grid>
    </Border>
</Window>
