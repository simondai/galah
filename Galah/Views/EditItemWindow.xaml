<Window x:Class="Galah.Views.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="条目"
        Width="540" Height="430" MinWidth="480" MinHeight="380"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, system-ui, sans-serif" FontSize="12.5"
        Icon="{DynamicResource Galah.WindowIcon}" Background="{DynamicResource Galah.Panel.Background}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Galah.Input.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Galah.Input.Border}" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Galah.Button.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Button.Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Galah.Button.Border}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header: title + kind + icon preview -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="6" Margin="0,0,12,0"
                    Background="{DynamicResource Galah.Tile.Hover}">
                <Image Source="{Binding IconPreview}" Width="34" Height="34" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Galah.Text.Primary}" />
                <TextBlock Text="{Binding KindLabel, StringFormat=类型：{0}（创建后不可更改）}" FontSize="11.5"
                           Foreground="{DynamicResource Galah.Text.Secondary}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- fields -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=120}" MaxLength="64" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="目标" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"
                     Text="{Binding Target, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Margin="6,3,0,3" Click="BrowseTarget_Click"
                    IsEnabled="{Binding CanBrowseTarget}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="参数" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3"
                     Text="{Binding Args, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     ToolTip="原样保存，不做转义" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="工作目录" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3"
                     Text="{Binding Workdir, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <Button Grid.Row="3" Grid.Column="2" Content="浏览…" Margin="6,3,0,3" Click="BrowseWorkdir_Click" />

            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="以管理员身份运行" IsChecked="{Binding RunAsAdmin}"
                          Foreground="{DynamicResource Galah.Text.Primary}" />
                <Button Content="选择图标…" Margin="16,0,0,0" Click="PickIcon_Click" />
                <Button Content="还原自动图标" Click="ResetIcon_Click" />
                <Button Content="{Binding FetchIconLabel}" Margin="16,0,0,0"
                        Command="{Binding FetchIconCommand}"
                        Visibility="{Binding IsUrlVisibility}" />
            </StackPanel>
        </Grid>

        <!-- inline validation -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,12,0,0">
            <Border Background="{DynamicResource Galah.Banner.Background}"
                    BorderBrush="{DynamicResource Galah.Banner.Border}" BorderThickness="1" CornerRadius="5"
                    Padding="8,6" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Errors}" TextWrapping="Wrap" Foreground="{DynamicResource Galah.Text.Primary}" />
            </Border>
            <TextBlock Text="{Binding IconModeText}" FontSize="11.5" Margin="0,8,0,0"
                       Foreground="{DynamicResource Galah.Text.Secondary}" />
            <Button Content="{Binding SuggestedKindLabel, StringFormat=删除并另加为{0}…}" HorizontalAlignment="Left"
                    Margin="0,10,0,0" Visibility="{Binding ShowSuggestedKindButton, Converter={StaticResource BoolToVis}}"
                    Click="DeleteAndReAdd_Click" />
        </StackPanel>

        <!-- actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="添加" MinWidth="84" Padding="18,10" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"
                    Visibility="{Binding IsNewVisibility}"
                    Background="{DynamicResource Galah.ActionBlue}" BorderThickness="0"
                    Foreground="{DynamicResource Galah.OnPrimary}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pill" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95" /></Setter.Value>
                                </Setter>
                                <Setter TargetName="pill" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="保存" MinWidth="84" Padding="18,10" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"
                    Visibility="{Binding IsEditVisibility}"
                    Background="{DynamicResource Galah.ActionBlue}" BorderThickness="0"
                    Foreground="{DynamicResource Galah.OnPrimary}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pill" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95" /></Setter.Value>
                                </Setter>
                                <Setter TargetName="pill" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
                        <Button Content="取消" MinWidth="74" Padding="14,8" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
