<Window x:Class="Galah.Views.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Galah 维护"
        Width="520" Height="560" MinWidth="460" MinHeight="440"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, system-ui, sans-serif" FontSize="12.5"
        Icon="{DynamicResource Galah.WindowIcon}" Background="{DynamicResource Galah.Panel.Background}">

    <Window.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
        </Style>
        <Style x:Key="CardNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Secondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Count" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Secondary}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource CardNote}" Margin="0,0,0,10">
                所有改动都走正常写盘路径（原子替换 + 滚动备份），删掉的条目可从备份恢复。
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- invalid -->
                <Border Background="{DynamicResource Galah.Parchment}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="清理失效项" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="目标文件/程序已不存在的条目" Style="{StaticResource CardNote}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource Count}"
                                   Text="{Binding InvalidCount, StringFormat={}{0} 项}" />
                        <Button Grid.Column="2" Content="执行" MinWidth="74" Margin="10,0,0,0"
                                Click="CleanInvalid_Click" IsEnabled="{Binding CanCleanInvalid}" />
                    </Grid>
                </Border>

                <!-- duplicates -->
                <Border Background="{DynamicResource Galah.Parchment}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="清理重复项" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="同一目标+参数只保留第一个" Style="{StaticResource CardNote}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource Count}"
                                   Text="{Binding DuplicateCount, StringFormat={}{0} 项}" />
                        <Button Grid.Column="2" Content="执行" MinWidth="74" Margin="10,0,0,0"
                                Click="CleanDuplicates_Click" IsEnabled="{Binding CanCleanDuplicates}" />
                    </Grid>
                </Border>

                <!-- sort -->
                <Border Background="{DynamicResource Galah.Parchment}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="按名称排序" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="每个分类内按名称重排（不改内容，无需确认）" Style="{StaticResource CardNote}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource Count}"
                                   Text="{Binding UnsortedTabCount, StringFormat={}{0} 类}" />
                        <Button Grid.Column="2" Content="执行" MinWidth="74" Margin="10,0,0,0"
                                Click="SortAll_Click" IsEnabled="{Binding CanSort}" />
                    </Grid>
                </Border>

                <!-- icon cache -->
                <Border Background="{DynamicResource Galah.Parchment}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="重建图标缓存" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="图标显示异常时用；不影响你自选的图标" Style="{StaticResource CardNote}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="执行" MinWidth="74" Margin="10,0,0,0"
                                Click="RebuildIcons_Click" />
                    </Grid>
                </Border>

                <!-- export / import -->
                <Border Background="{DynamicResource Galah.Parchment}" CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="库备份" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="导出到 GalahData/exports；导入可选合并或替换" Style="{StaticResource CardNote}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="导出" MinWidth="74" Margin="10,0,0,0" Click="Export_Click" />
                        <Button Grid.Column="2" Content="导入…" MinWidth="74" Margin="8,0,0,0" Click="Import_Click"
                                Style="{StaticResource Galah.ButtonPrimary}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="ResultLine" Margin="2,12,0,4" Style="{StaticResource CardNote}"
                   Text="{Binding LastResult}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="关闭" MinWidth="74" Padding="14,8" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
