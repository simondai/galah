<Window x:Class="Galah.Views.AddPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加快捷方式"
        Width="700" Height="500" MinWidth="560" MinHeight="380"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, system-ui, sans-serif" FontSize="12.5"
        Icon="{DynamicResource Galah.WindowIcon}" Background="{DynamicResource Galah.Panel.Background}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <!-- named for UIA and screen readers: the template is composite, so the container
             would otherwise expose an empty name -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="4,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Galah.Tile.Selected}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeedItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="3,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Galah.Tile.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Galah.Tile.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- filter -->
        <TextBox x:Name="FilterBox" Grid.Row="0" Margin="0,0,0,10" Padding="8,6"
                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                 Background="{DynamicResource Galah.Input.Background}"
                 Foreground="{DynamicResource Galah.Text.Primary}"
                 BorderBrush="{DynamicResource Galah.Input.Border}"
                 ToolTip="按名称过滤（输入即筛）" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- categories -->
            <ListBox Grid.Column="0" x:Name="CategoryList" Margin="0,0,10,0"
                     ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     ItemContainerStyle="{StaticResource CategoryItem}"
                     Background="{DynamicResource Galah.TabStrip.Background}" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Galah.Text.Primary}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- candidates -->
            <ListBox Grid.Column="1" x:Name="SeedList"
                     ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                     MouseDoubleClick="SeedList_MouseDoubleClick"
                     ItemContainerStyle="{StaticResource SeedItem}"
                     Background="{DynamicResource Galah.Input.Background}"
                     Foreground="{DynamicResource Galah.Text.Primary}"
                     BorderBrush="{DynamicResource Galah.Input.Border}" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" Margin="0,0,10,0" Background="Transparent">
                                <Image Source="{Binding Icon}" Width="32" Height="32"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Galah.Text.Primary}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                <TextBlock Text="{Binding Note}" FontSize="11"
                                           Foreground="{DynamicResource Galah.Text.Secondary}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="360"
 />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- footer: action left, cancel right (product rule 2026-11-18) -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="双击条目即可添加" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource Galah.Text.Secondary}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="添加" MinWidth="84" Padding="18,10" Margin="0,0,8,0"
                        IsDefault="True" Click="Add_Click"
                        Style="{StaticResource Galah.ButtonPrimary}"
                        IsEnabled="{Binding CanAdd}" />
                <Button Content="取消" MinWidth="74" Padding="14,8" Click="Cancel_Click" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
