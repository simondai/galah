<Window x:Class="Galah.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Galah 设置"
        Width="520" Height="560" MinWidth="460" MinHeight="420"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, system-ui, sans-serif" FontSize="12.5"
        Icon="{DynamicResource Galah.WindowIcon}" Background="{DynamicResource Galah.Panel.Background}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Galah.Text.Primary}" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="16,10,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="主题" VerticalAlignment="Center"
                               Foreground="{DynamicResource Galah.Text.Secondary}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="0,4"
                              ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="图标大小" VerticalAlignment="Center"
                               Foreground="{DynamicResource Galah.Text.Secondary}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="0,4"
                              ItemsSource="{Binding IconSizeOptions}" SelectedItem="{Binding IconSize}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="标签位置" VerticalAlignment="Center"
                               Foreground="{DynamicResource Galah.Text.Secondary}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="0,4"
                              ItemsSource="{Binding TabPositionOptions}" SelectedItem="{Binding TabPosition}" />
                </Grid>

                <TextBlock Text="交互" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="点击方式" VerticalAlignment="Center"
                               Foreground="{DynamicResource Galah.Text.Secondary}" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Margin="0,4"
                              ItemsSource="{Binding ClickModeOptions}" SelectedItem="{Binding ClickMode}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="面板材质" VerticalAlignment="Center"
                               Foreground="{DynamicResource Galah.Text.Secondary}" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Margin="0,4"
                              ItemsSource="{Binding PanelMaterialOptions}" SelectedItem="{Binding PanelMaterial}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="面板位置" VerticalAlignment="Center"
                               Foreground="{DynamicResource Galah.Text.Secondary}" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Margin="0,4"
                              ItemsSource="{Binding PanelPlacementOptions}" SelectedItem="{Binding PanelPlacement}" />
                </Grid>
                <CheckBox Content="滚轮滚到边缘时切换分类" IsChecked="{Binding WheelSwitchTab}" />
                <CheckBox Content="Ctrl+1..9 快速切换分类" IsChecked="{Binding NumberKeysSwitchTab}" />
                <CheckBox Content="启动成功后隐藏面板" IsChecked="{Binding HideOnLaunch}" />
                <CheckBox Content="面板失焦时自动隐藏" IsChecked="{Binding HideOnBlur}" />

                <TextBlock Text="全局快捷键" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}" Width="170"
                             Padding="4,3" VerticalContentAlignment="Center"
                             Background="{DynamicResource Galah.Input.Background}"
                             Foreground="{DynamicResource Galah.Text.Primary}"
                             BorderBrush="{DynamicResource Galah.Input.Border}" />
                    <Button Content="应用" Click="ApplyHotkey_Click" />
                    <Button Content="恢复默认" Click="RestoreHotkey_Click" />
                </StackPanel>
                <!-- Run.Text binding is a known WPF namescope trap; bind the whole line instead -->
                <TextBlock FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{Binding HotkeyHint, StringFormat=提示：{0}}"
                           Foreground="{DynamicResource Galah.Banner.Border}"
                           Visibility="{Binding HasHotkeyHint, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="系统" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="开机时自动启动 Galah（当前用户）" IsChecked="{Binding AutoStart}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="创建桌面快捷方式" MinWidth="130" Click="CreateShortcut_Click" />
                    <TextBlock x:Name="ShortcutResultLine" FontSize="11.5" VerticalAlignment="Center"
                               Margin="10,0,0,0" Foreground="{DynamicResource Galah.Text.Secondary}" />
                </StackPanel>

                <TextBlock Text="库维护" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="维护与迁移…" MinWidth="110" Click="Maintenance_Click" />
                    <TextBlock Text="清理失效/重复项、按名称排序、重建图标缓存、导出导入"
                               FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource Galah.Text.Secondary}" />
                </StackPanel>

                <TextBlock Text="需要注意" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2"
                                       Foreground="{DynamicResource Galah.Text.Secondary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="（没有需要处理的问题）" FontSize="11.5"
                           Foreground="{DynamicResource Galah.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="改动即时生效并保存" VerticalAlignment="Center" FontSize="11.5"
                       Foreground="{DynamicResource Galah.Text.Secondary}" />
            <Button Content="关闭" MinWidth="76" Margin="12,0,0,0" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
