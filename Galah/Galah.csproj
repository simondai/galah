<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>Galah</AssemblyName>
    <RootNamespace>Galah</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Product>Galah</Product>
    <AssemblyTitle>Galah</AssemblyTitle>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- Green / portable build: no install step, no third-party packages. -->
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF SDK's implicit usings omit System.IO; every persistence path needs it. -->
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
