<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Must match Galah: the app is a WPF (net8.0-windows) assembly and the LinkResolver fixture
         needs a real shell + STA apartment, so the harness is a Windows-targeted x64 console app. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Galah.Tests</AssemblyName>
    <RootNamespace>Galah.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The suite is not allowed to touch the real data folder: every fixture lives under
         %LOCALAPPDATA%\Temp\GalahTests-* and is deleted at the end. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Galah\Galah.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../Galah/app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
